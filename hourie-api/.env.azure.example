# Application settings of the Hourie web app on Azure App Service (Linux, PHP 8.4).
# Enter them in the web app's Configuration > Application settings, not in a .env file.
# Secrets use Key Vault references: @Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/<name>/)
# Startup command: bash /home/site/wwwroot/deploy-azure/startup.sh

APP_NAME=Hourie
APP_ENV=production
APP_KEY=@Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/app-key/)
APP_DEBUG=false
APP_URL=https://assets.hourie.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
# The Application Gateway and the App Service front ends sit in front of the app;
# the web app is reachable only through them (public access disabled).
TRUSTED_PROXIES=*
AUTH_REMEMBER_MINUTES=43200

# Logs go to the console so App Service sends them to Log Analytics.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=<server>.mysql.database.azure.com
DB_PORT=3306
DB_DATABASE=hourie
DB_USERNAME=hourie
DB_PASSWORD=@Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/db-password/)
# Azure MySQL requires TLS; the image's CA bundle includes its certificate authority.
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=assets.hourie.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=assets.hourie.com

CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=150

# Uploaded files in Blob Storage, through the private endpoint, signed in with
# the web app's managed identity (role: Storage Blob Data Contributor).
FILES_STORAGE=azure-blob
AZURE_STORAGE_ACCOUNT=<storage-account>
AZURE_STORAGE_CONTAINER=hourie-files

# Azure keeps the backups (MySQL point-in-time restore, Blob soft delete and versioning).
BACKUP_ENABLED=false

# true only if WebJobs are not used: startup.sh then runs the scheduler and the queue worker.
HOURIE_RUN_BACKGROUND=false

MAIL_MAILER=microsoft-graph
MAIL_FROM_ADDRESS=notifications@hourie.com
MAIL_FROM_NAME="A.B. Hourie Asset Management"
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=@Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/graph-client-secret/)

# The zip is already built by deploy/azure/package.sh: no build on the server.
SCM_DO_BUILD_DURING_DEPLOYMENT=false
