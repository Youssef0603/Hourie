APP_NAME=Hourie
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://inventory.example.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
AUTH_REMEMBER_MINUTES=43200

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hourie
DB_USERNAME=hourie
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=inventory.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=inventory.example.com

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local
EQUIPMENT_IMAGES_DISK=equipment-images
EQUIPMENT_IMAGES_ROOT=/var/www/hourie/shared/equipment-images
