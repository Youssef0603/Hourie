APP_NAME=Hourie
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://assets.hourie.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
# Address of the Azure Application Gateway if one terminates HTTPS in front of IIS (comma-separated). Leave empty otherwise.
TRUSTED_PROXIES=
AUTH_REMEMBER_MINUTES=43200

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hourie
DB_USERNAME=hourie
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=assets.hourie.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=assets.hourie.com

CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=150

FILESYSTEM_DISK=local
EQUIPMENT_IMAGES_DISK=equipment-images
EQUIPMENT_IMAGES_ROOT=D:\Hourie\uploads\equipment-images
EQUIPMENT_DOCUMENTS_DISK=equipment-documents
EQUIPMENT_DOCUMENTS_ROOT=D:\Hourie\uploads\equipment-documents

BACKUP_ROOT=D:\Hourie\backups
BACKUP_DIRECTORY=HOURIE_BACKUPS
BACKUP_RETENTION_COUNT=30
BACKUP_MINIMUM_FREE_BYTES=1073741824
MYSQLDUMP_BINARY=C:\Program Files\MySQL\MySQL Server 8.4\bin\mysqldump.exe
MYSQL_BINARY=C:\Program Files\MySQL\MySQL Server 8.4\bin\mysql.exe

MAIL_MAILER=microsoft-graph
MAIL_FROM_ADDRESS=notifications@hourie.com
MAIL_FROM_NAME="A.B. Hourie Asset Management"
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
